filters:
  and:
    - and:
        - '!file.inFolder("01 - Primary Categories")'
        - '!file.inFolder("02 - Secondary Categories")'
        - '!file.inFolder("04 - Templates")'
    - and:
        - '!file.inFolder("03 - Content/files")'
        - '!file.inFolder("05 - Personal/files")'
views:
  - type: table
    name: All Open & WIP Notes
    filters:
      and:
        - status != "evergreen"
    order:
      - file.name
      - aliases
      - status
      - tags
      - last modified date
      - creation date
    sort:
      - property: last modified date
        direction: DESC
      - property: type
        direction: DESC
      - property: tags
        direction: DESC
      - property: aliases
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 396
      note.aliases: 172
  - type: table
    name: All Evergreen Notes
    filters:
      and:
        - status == "evergreen"
    order:
      - file.name
      - aliases
      - tags
    sort:
      - property: type
        direction: DESC
      - property: tags
        direction: DESC
      - property: aliases
        direction: ASC
      - property: status
        direction: ASC
      - property: last modified date
        direction: ASC
      - property: creation date
        direction: DESC
    columnSize:
      file.name: 396
      note.aliases: 172
  - type: table
    name: Incorrect Location
    filters:
      and:
        - '!file.inFolder("03 - Content")'
        - '!file.inFolder("05 - Personal")'
        - and:
            - '!file.inFolder("06 - Periodic Notes/Daily Notes")'
            - '!file.hasTag("daily-note")'
    order:
      - file.name
      - aliases
      - status
      - tags
      - file.folder
    sort:
      - property: last modified date
        direction: DESC
      - property: type
        direction: DESC
      - property: tags
        direction: DESC
      - property: aliases
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 396
      note.aliases: 172
  - type: table
    name: No Status
    filters:
      and:
        - or:
            - '!file.hasProperty("status")'
            - '!file.hasTag("daily-note")'
    order:
      - file.name
      - aliases
      - status
      - tags
      - file.folder
    sort:
      - property: last modified date
        direction: DESC
      - property: type
        direction: DESC
      - property: tags
        direction: DESC
      - property: aliases
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 396
      note.aliases: 172
