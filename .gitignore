# to exclude Obsidian workspace settings (including plugin and hotkey configurations)
#.obsidian/*

# OR only to exclude workspace cache
#.obsidian/workspace/*
.obsidian/workspace.json


# Exclude graph
.obsidian/graph.json

# Exclude plugins
#.obsidian/plugins/*

# OR only to specific plugin data
.obsidian/plugins/key-promoter/data.json
.obsidian/plugins/recent-files-obsidian/data.json
.obsidian/plugins/obsidian-open-link-with/data.json

# Exclude hotkeys (for avoiding issues between different operating system)
.obsidian/hotkeys.json

# Exclude specific files "personal"
05*-*Personal/

# Exclude Day Planner directory placed in vault root
#Day*Planners/*

# This file is used to keep track of last auto backup/pull
#.obsidian-git-data

# Exclude Untitled Notes
Untitled*

# Exclude "bad" names
null*

# Add below lines to exclude OS settings and caches
.trash/
.DS_Store

# Exclude further files
"orphaned files output"
"broken links output"
"files without tags"
"empty files"